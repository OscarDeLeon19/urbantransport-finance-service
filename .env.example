# Perfil y puerto
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8087

# Base de datos
DB_HOST=
DB_PORT=5432
DB_NAME=finance_db
DB_USER=
DB_PASSWORD=

# Kafka (IP privada de la EC2 de Kafka)
KAFKA_BOOTSTRAP=localhost

# Identity (IP privada de su EC2; sin puerto si sigue detrás de nginx)
IDENTITY_JWKS_URI=http://<IP_PRIVADA_IDENTITY>/.well-known/jwks.json

# Fleet (IP privada de su EC2; con puerto si la pasas a la instancia compartida)
FLEET_URL=http://<IP_PRIVADA_FLEET>

# Clave compartida con identity, customer, fleet y trip (debe ser idéntica en todos)
# Generar con: openssl rand -base64 32
INTERNAL_API_KEY=